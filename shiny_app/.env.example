# Copy to .env in this folder and fill in values. Do not commit .env.

# --- Posit Connect (local `rsconnect deploy` only; app runtime secrets belong in Connect UI Vars) ---
# Your Connect user API key (Account → API keys). Used to publish from your laptop, not read by Shiny at runtime.
Connect_API_Key=
# rsconnect also accepts this name (optional duplicate of the same key):
# CONNECT_API_KEY=
# If the CLI fails TLS verify to your Connect host (common with private CAs): CONNECT_INSECURE=1
# CONNECT_SERVER=https://connect.systems-apps.com

SUPABASE_URL=
# Prefer this file (shiny_app/.env): server.py loads workspace .env, then TravelDashboard/.env,
# then this file — each step overrides. A wrong SUPABASE_KEY here replaces a correct key in a parent .env.
# Project Settings → API Keys → Legacy API keys → anon (long string starting with eyJ), not sb_publishable_….
SUPABASE_KEY=
# Optional (recommended for local dev): Legacy service_role JWT (starts with eyJ).
# Using service_role avoids RLS blocking server-side reads for preference preload.
SUPABASE_SERVICE_KEY=

OLLAMA_API_KEY=
# Optional; base URL only (default https://ollama.com). Do not include /api or /api/chat or requests 404.
# OLLAMA_HOST=
#
# Models (Ollama Cloud): Agent 2 = main Generate JSON; Agent 1 = Places+embeddings only (no LLM) unless you add one.
# Defaults in code: Agent 2 = nemotron-3-nano:30b-cloud; everything else = gpt-oss:20b-cloud.
# OLLAMA_MODEL_AGENT2=          # override Agent 2 only
# OLLAMA_MODEL_AGENT1=          # reserved / future Agent 1 LLM; if unset, same default tier as Agent 2
# OLLAMA_MODEL_AGENTS=          # optional: set both agent tiers at once (used when AGENT1/AGENT2 unset)
# OLLAMA_MODEL_OTHER=           # advisory summary + friendliness report prose (alias: OLLAMA_MODEL_AUXILIARY)
# OLLAMA_MODEL=                 # fallback for OTHER tier only (not for Agent 2)
# Optional; cap completion tokens for the main plan JSON (e.g. 1800). Too low may truncate JSON.
# OLLAMA_NUM_PREDICT=
# Optional: cap for U.S. advisory 1–2 sentence helper only (default 512 in code; too low truncates mid-sentence).
# OLLAMA_ADVISORY_NUM_PREDICT=

# Optional: skip travel friendliness (World Bank + optional Ollama report prose) during Generate — speeds up testing.
# TD_DISABLE_TRAVEL_FRIENDLINESS=1
# Optional: keep World Bank scores + report, but skip the extra Ollama call for HTML report prose only.
# TD_FRIENDLINESS_SKIP_REPORT_LLM=1
# Optional: short system prompt instead of full docs/architecture.md for the main plan model (fewer input tokens).
# TD_LIGHT_ARCH_CONTEXT=1

# Optional: U.S. travel advisory table cache TTL in seconds (default 86400 = 24h). Unofficial feed; longer TTL is gentler on travel.state.gov.
# TD_US_ADVISORY_CACHE_SECONDS=86400

# Optional: Places API (New) — Text Search + Place Details for Agent 1 restaurant retrieval.
# https://developers.google.com/maps/documentation/places/web-service/text-search
GOOGLE_PLACES_API_KEY=
# Dining map uses Maps Embed API (iframe) with the same key — enable “Maps Embed API” on this project.
# With HTTP referrer restrictions, allow your app origin (e.g. http://127.0.0.1:8000/*).

# NYT Article Search API — Destination news in Essential info (headlines are empty without this key).
# https://developer.nytimes.com/docs/articlesearch-product/1/overview
NYT_API_KEY=
