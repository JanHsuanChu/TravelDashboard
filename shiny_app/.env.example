# Copy to .env in this folder and fill in values. Do not commit .env.

SUPABASE_URL=
# Project Settings → API. supabase-py 2.15.x only accepts JWT keys (legacy anon or service_role,
# both start with eyJ). Keys like sb_publishable_… / sb_secret_… are rejected as "Invalid API key"
# by the library before any request. Reveal "legacy anon key" in the dashboard if needed.
SUPABASE_KEY=

OLLAMA_API_KEY=
# Optional; defaults to https://ollama.com when building the chat API URL.
# OLLAMA_HOST=

# Optional: Places API (New) — Text Search + Place Details for Agent 1 restaurant retrieval.
# https://developers.google.com/maps/documentation/places/web-service/text-search
GOOGLE_PLACES_API_KEY=
# Dining map uses Maps Embed API (iframe) with the same key — enable “Maps Embed API” on this project.
# With HTTP referrer restrictions, allow your app origin (e.g. http://127.0.0.1:8000/*).
