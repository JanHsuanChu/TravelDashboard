# Copy to .env in this folder and fill in values. Do not commit .env.

SUPABASE_URL=
# Use the project "anon" (JWT), "service_role" (JWT, server-only), or new sb_secret_* key.
# If you use sb_secret_..., the client sets a non-browser User-Agent (required by Supabase).
SUPABASE_KEY=

OLLAMA_API_KEY=
# Optional; defaults to https://ollama.com when building the chat API URL.
# OLLAMA_HOST=
